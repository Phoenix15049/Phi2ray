<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Phi2ray</vendor>
  <vendor_url>https://github.com/Phoenix15049/Phi2ray</vendor_url>
  <icon_name>phi2ray-app</icon_name>

  <!-- The helper, as packages install it. The password is asked once per session of the app. -->
  <action id="com.phi2ray.helper">
    <description>Run the Phi2ray helper</description>
    <message>Phi2ray needs your permission to set up the VPN adapter and the kill switch.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/phi2ray/phi2ray-helper</annotate>
  </action>

  <!-- The same helper, as the AppImage sets it up. -->
  <action id="com.phi2ray.helper.opt">
    <description>Run the Phi2ray helper</description>
    <message>Phi2ray needs your permission to set up the VPN adapter and the kill switch.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/phi2ray/phi2ray-helper</annotate>
  </action>
</policyconfig>
