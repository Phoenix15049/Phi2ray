<?xml version="1.0" encoding="utf-8"?>
<!-- Paste this into the SignPath project's artifact configuration. It signs the one exe in the
     artifact from the release workflow, and only if its metadata names this project and version. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Phi2ray-${version}-windows-x64.exe" product-name="Phi2ray" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
